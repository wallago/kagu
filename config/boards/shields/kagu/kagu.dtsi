#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        // col-gpios are per-half, see kagu_{left,right}.overlay
        row-gpios
            = <&xiao_d  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row1
            , <&xiao_d  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row2
            , <&xiao_d  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row3
            , <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row4
            ;
    };

    // Columns 0-4 are the left half, 5-9 the right half; the right overlay
    // shifts its local columns into 5-9 with col-offset.
//  | SW5  | SW4  | SW3  | SW2  | SW1  |   | SW1  | SW2  | SW3  | SW4  | SW5  |
//  | SW10 | SW9  | SW8  | SW7  | SW6  |   | SW6  | SW7  | SW8  | SW9  | SW10 |
//  | SW15 | SW14 | SW13 | SW12 | SW11 |   | SW11 | SW12 | SW13 | SW14 | SW15 |
//                | SW18 | SW17 | SW16 |   | SW16 | SW17 | SW18 |
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    // Key positions for ZMK Studio, from the PCB switch centres in
    // case/kagu_{left,right}_geom.scad (1u = 17mm, y flipped, right half
    // shifted 110mm right). Same order as default_transform.
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w   h    x    y     rot   rx   ry
            = <&key_physical_attrs 100 100    0  112       0    0    0>
            , <&key_physical_attrs 100 100  106   41       0    0    0>
            , <&key_physical_attrs 100 100  212    6       0    0    0>
            , <&key_physical_attrs 100 100  318   47       0    0    0>
            , <&key_physical_attrs 100 100  424   59       0    0    0>
            , <&key_physical_attrs 100 100  794   59       0    0    0>
            , <&key_physical_attrs 100 100  900   47       0    0    0>
            , <&key_physical_attrs 100 100 1006    6       0    0    0>
            , <&key_physical_attrs 100 100 1112   41       0    0    0>
            , <&key_physical_attrs 100 100 1218  112       0    0    0>
            , <&key_physical_attrs 100 100    0  212       0    0    0>
            , <&key_physical_attrs 100 100  106  141       0    0    0>
            , <&key_physical_attrs 100 100  212  106       0    0    0>
            , <&key_physical_attrs 100 100  318  147       0    0    0>
            , <&key_physical_attrs 100 100  424  159       0    0    0>
            , <&key_physical_attrs 100 100  794  159       0    0    0>
            , <&key_physical_attrs 100 100  900  147       0    0    0>
            , <&key_physical_attrs 100 100 1006  106       0    0    0>
            , <&key_physical_attrs 100 100 1112  141       0    0    0>
            , <&key_physical_attrs 100 100 1218  212       0    0    0>
            , <&key_physical_attrs 100 100    0  312       0    0    0>
            , <&key_physical_attrs 100 100  106  241       0    0    0>
            , <&key_physical_attrs 100 100  212  206       0    0    0>
            , <&key_physical_attrs 100 100  318  247       0    0    0>
            , <&key_physical_attrs 100 100  424  259       0    0    0>
            , <&key_physical_attrs 100 100  794  259       0    0    0>
            , <&key_physical_attrs 100 100  900  247       0    0    0>
            , <&key_physical_attrs 100 100 1006  206       0    0    0>
            , <&key_physical_attrs 100 100 1112  241       0    0    0>
            , <&key_physical_attrs 100 100 1218  312       0    0    0>
            , <&key_physical_attrs 100 100  282  365       0    0    0>
            , <&key_physical_attrs 100 100  400  382    2000  450  432>
            , <&key_physical_attrs 100 100  524  400    3000  574  450>
            , <&key_physical_attrs 100 100  694  400 (-3000)  744  450>
            , <&key_physical_attrs 100 100  818  382 (-2000)  868  432>
            , <&key_physical_attrs 100 100  935  365       0    0    0>
            ;
    };
};
