#include <dt-bindings/zmk/matrix_transform.h>

/ {
      chosen {
              zmk,kscan = &kscan0;
              zmk,matrix-transform = &default_transform;
      };

      kscan0: kscan {
              compatible = "zmk,kscan-gpio-matrix";
              diode-direction = "col2row";
              wakeup-source;

              col-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;                       // D0
              row-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;    // D1
      };

      default_transform: keymap_transform {
              compatible = "zmk,matrix-transform";
              columns = <1>;
              rows = <1>;
              map = <RC(0,0)>;
      };
};

/ {
      aliases {
              led-red = &led0;
              led-green = &led1;
              led-blue = &led2;
      };

      leds { status = "okay"; };
};

&led0 { gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>; };    // D8  = P1.13
&led1 { gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>; };    // D9  = P1.14
&led2 { gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>; };    // D10 = P1.15
