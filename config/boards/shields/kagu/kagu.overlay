#include <dt-bindings/zmk/matrix_transform.h>

/ {
      chosen {
              zmk,kscan = &kscan0;
              zmk,matrix-transform = &default_transform;
      };

      kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
          = <&xiao_d 0 GPIO_ACTIVE_HIGH>   // D0  col1
          , <&xiao_d 1 GPIO_ACTIVE_HIGH>   // D1  col2
          , <&xiao_d 2 GPIO_ACTIVE_HIGH>   // D2  col3
          , <&xiao_d 3 GPIO_ACTIVE_HIGH>   // D3  col4
          , <&xiao_d 4 GPIO_ACTIVE_HIGH>   // D4  col5
          ;

        row-gpios
          = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D7   row1
          , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D8   row2
          , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D9   row3
          , <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D10  row4
          ;
      };

      default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
          RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
          RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
          RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
                          RC(3,2) RC(3,1) RC(3,0)
        >;
      };
};

